# ============================================
# Financial Intelligence Platform — Environment
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME=financial-terminal
APP_ENV=development          # development | staging | production
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Database (PostgreSQL + pgvector) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/financial_terminal
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Redis (Cache + Rate Limiting + Celery Broker) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=your-fernet-key-here
JWT_SECRET_KEY=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- SEC EDGAR ---
EDGAR_USER_AGENT=YourName your-email@example.com
EDGAR_RATE_LIMIT_PER_SECOND=10

# --- Object Storage (Cloudflare R2) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=financial-terminal-raw
R2_ENDPOINT_URL=

# --- AI Providers (for internal/extraction use only) ---
# User reasoning models are BYOM — stored encrypted per user
GROQ_API_KEY=               # Free tier — used for extraction model
GEMINI_API_KEY=             # Free tier — fallback extraction

# --- Embedding Model ---
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# --- Sentry (Error Tracking) ---
SENTRY_DSN=

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
